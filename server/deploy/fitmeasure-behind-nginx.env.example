# Settings for running behind an existing nginx (see nginx-site.conf), which
# serves HTTPS on 443. Copy to /etc/fitmeasure/fitmeasure.env and fill in.

# Only nginx talks to this.
FITMEASURE_ADDR=127.0.0.1:8090

# The droplet's own public IPv4 (eth0), not a reserved IP: media replies
# leave from this address, so clients must be sent to it.
FITMEASURE_PUBLIC_IP=

FITMEASURE_UDP_PORT=7882
FITMEASURE_TCP_PORT=7881
FITMEASURE_TURN_PORT=3478

# Lets the Android app open room links (package:sha256 of its signing
# certificate; see server/README.md).
#FITMEASURE_ANDROID_APP=com.fitmeasure.fitmeasure:a0babc5bee3a993c782289bbaaf3e0937e0e99b8cabebcfc3a5d5e4456fc48f7
