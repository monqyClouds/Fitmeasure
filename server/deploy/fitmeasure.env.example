# Copy to /etc/fitmeasure/fitmeasure.env on the server and fill in.

# HTTPS for the site, with a Let's Encrypt certificate (ports 443 and 80).
FITMEASURE_DOMAIN=live.somto.si
FITMEASURE_ACME_EMAIL=

# TURN over TLS on 443, told apart from HTTPS by this hostname.
FITMEASURE_TURN_DOMAIN=turn.somto.si

# The droplet's public IPv4 address.
FITMEASURE_PUBLIC_IP=

# Media straight to the SFU: one UDP port, and TCP for networks without UDP.
FITMEASURE_UDP_PORT=7882
FITMEASURE_TCP_PORT=7881

# TURN over UDP and TCP.
FITMEASURE_TURN_PORT=3478

# Lets the Android app open room links (package:sha256 of its signing
# certificate; see server/README.md).
#FITMEASURE_ANDROID_APP=com.fitmeasure.fitmeasure:a0babc5bee3a993c782289bbaaf3e0937e0e99b8cabebcfc3a5d5e4456fc48f7
